/*
 * Main entry point for the activemq module. Including this file pulls
 * in the whole client API:
 *
 *   ActiveMqBroker      - embedded broker (in-memory or persistent)
 *   ActiveMqConnection  - connection to an embedded or remote broker
 *   ActiveMqSession     - sessions, transactions, message factories
 *   ActiveMqDestination - queues, topics, temporary destinations
 *   ActiveMqProducer    - sending
 *   ActiveMqConsumer    - synchronous receiving
 *   ActiveMqBrowser     - queue browsing
 *   ActiveMqMessage     - all message types, headers, properties
 *   ActiveMqListener    - Aussom Server ClientListener connector
 *
 * Individual files can be included instead (include activemq.broker;)
 * when only part of the API is needed.
 */

include activemq.broker;
include activemq.connection;
include activemq.session;
include activemq.destination;
include activemq.producer;
include activemq.consumer;
include activemq.browser;
include activemq.message;
include activemq.listener;
