	public getCastRealLifeTrivia() {
		return hogans_heroes.castRealLifeTrivia;
	}

	/**
	 * Returns production-side trivia: creators, network, awards,
	 * sets, and post-show history.
	 * @r A list of trivia strings.
	 */
	public getProductionTrivia() {
		return hogans_heroes.productionTrivia;
	}

	/**
	 * Returns lighter in-universe and behind-the-scenes oddities.
	 * @r A list of trivia strings.
	 */
	public getFunFacts() {
		return hogans_heroes.funFacts;
